# TrafficEye AI — Environment Configuration

# Application Mode & Debugging
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=trafficeye-super-secret-key-change-in-production-2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# SQLite default for simple zero-config local run:
DATABASE_URL=sqlite:///./trafficeye.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql://trafficeye_user:trafficeye_password@localhost:5432/trafficeye_db

# Computer Vision & Inference Configuration
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
DEVICE=cpu

# License Plate OCR Configuration
OCR_ENGINE=easyocr
OCR_CONFIDENCE_THRESHOLD=0.60

# File Upload & Evidence Storage
UPLOAD_DIRECTORY=uploads
EVIDENCE_DIRECTORY=evidence
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# Fine Rates (Motor Vehicles Act Standard Fees in INR ₹)
FINE_NO_HELMET=500
FINE_TRIPLE_RIDING=1000
FINE_WRONG_PARKING=500
FINE_RED_LIGHT=1000
